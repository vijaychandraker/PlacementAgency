<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="PlacementAgency.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Placement Agency Management</title>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>
    <webopt:BundleReference runat="server" Path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />
        <style>
        html, body {
            height: 100%;
        }

        body {
            margin: 0;
            min-height: 100vh;
        }

        /* Make the whole page (inside the form) a vertical flex layout */
        form[runat="server"] {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* main container under navbar should take remaining height between navbar and footer */
        form[runat="server"] > .container-fluid {
            flex: 1 0 auto;
        }
        /* THEME */
        .navbar {
            background-color: #b2cbe5;
        }

        .sidebar {
            background-color: #c6e2ff;
            min-height: 100%;
        }

            .sidebar .nav-link {
                display: flex;
                align-items: center;
                gap: .5rem;
                padding: .55rem .85rem;
                border-radius: .45rem;
                color: #003366;
                font-weight: 500;
                font-size: 0.95rem;
                text-decoration: none;
                transition: background-color .15s ease, color .15s ease, transform .08s ease;
            }

                .sidebar .nav-link i {
                    font-size: 1.1rem;
                }

                .sidebar .nav-link p {
                    margin: 0;
                }

                .sidebar .nav-link:hover {
                    background: #b2d8ff;
                    color: #000;
                    transform: translateX(2px);
                }

                .sidebar .nav-link.active {
                    background: #96c5ff;
                    color: #000;
                }

        /* LAYOUT — no fixed positioning anywhere */
        main {
            background: #fff;
        }

        /* Footer sits after content and is pushed down when content is short */
        footer {
            background: #f8f9fa;
            margin-top: auto;
        }

        /* Small devices: refine navbar and stack content nicely */
        @media (max-width: 767.98px) {
            .navbar .navbar-brand {
                font-weight: 600;
                font-size: 1rem;
            }

            .navbar-nav.ms-auto {
                margin-top: .5rem;
            }

            .navbar-nav .nav-item {
                margin-bottom: .15rem;
            }

            .sidebar {
                padding-top: .5rem;
            }

            .sidebar .nav-link {
                padding: .45rem .75rem;
                font-size: 0.9rem;
            }
        }

        /* Borderless toggle button (icon-only) */
        #toggleSidebarBtn {
            border: none !important;
            box-shadow: none !important;
            outline: none !important;
            background: transparent !important;
            padding: .25rem .5rem;
        }

            #toggleSidebarBtn:hover {
                background: rgba(0,0,0,.05);
                border-radius: .35rem;
            }
    </style>
</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server" />

        <!-- TOP NAVBAR -->
        <nav class="navbar navbar-expand-sm navbar-light shadow-sm">
            <div class="container-fluid">
                <!-- Sidebar Toggle -->
                <button type="button" id="toggleSidebarBtn" class="me-2">
                    <i class="bi bi-list" style="font-size: 1.5rem;"></i>
                </button>

                <a class="navbar-brand text-dark" href="#">Placement Agency</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                    aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="nav-item"> <a style="font-weight:700">UserName:- </a>
                            <asp:Label ID="lblusername" runat="server"></asp:Label> &nbsp</li>
                        <li class="nav-item"><a style="font-weight:700"> UserRole:-</a>
                            <asp:Label ID="lbluserrole" runat="server"></asp:Label> &nbsp</li>
                        <li class="nav-item"><a style="font-weight:700"> District:- </a>
                            <asp:Label ID="lbldistrict" runat="server"></asp:Label></li>
                        <li class="nav-item ms-3">
                            <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn btn-sm btn-outline-danger" CausesValidation="false">
                                <i class="bi bi-box-arrow-right me-1"></i>Logout
                            </asp:LinkButton>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- GRID LAYOUT (sidebar is NOT fixed; it scrolls with page) -->
        <div class="container-fluid">
            <div class="row">
                <!-- SIDEBAR -->
                <nav id="sidebarMenu" class="col-md-3 col-lg-2 sidebar py-3">
                    <ul class="nav flex-column">
                        
                      <li id="lidashboard" runat="server" class="nav-item">
        <a href="<%= ResolveUrl("~/UI/Dashboard/Dashboard.aspx") %>"  class="nav-link">
            <p><i class="bi bi-speedometer2 me-2"></i>Dashboard</p>
        </a>
    </li>
                         <li id="lidistapprovepayroll" runat="server" class="nav-item">
         <a href="<%= ResolveUrl("~/UI/Dist/DistApprove.aspx") %>"  class="nav-link">
             <p><i class="bi bi-check2-circle me-2"></i>Approve Payroll</p>
         </a>
     </li>
                                            <li id="liagencyapprove" runat="server" class="nav-item">
    <a href="<%= ResolveUrl("~/UI/Agency/csmcl_AgencyApprovel.aspx") %>"  class="nav-link">
        <p><i class="bi bi-check2-circle me-2"></i>Approve Payroll</p>
    </a>
</li>
                        
                        <li id="lipayrolentry" runat="server" class="nav-item">
                                <a href="<%= ResolveUrl("~/UI/Dist/csmcl_DistEntry.aspx") %>"  class="nav-link">
                                    <p><i class="bi bi-pencil-square me-2"></i>Payroll Entry</p>
                                </a>
                            </li>

                        <li id="liapproveststus" runat="server" class="nav-item">
                                <a href="<%= ResolveUrl("~/UI/Dist/csmclDistApproveStatus.aspx") %>"  class="nav-link">
                                    <p><i class="bi bi-clipboard-check me-2"></i>Approve Status</p>
                                </a>
                            </li>
                       <li id="lireport" runat="server" class="nav-item">
        <a href="<%= ResolveUrl("~/UI/Dist/csmcl_EntryReport.aspx") %>"  class="nav-link">
            <p><i class="bi bi-file-earmark-bar-graph me-2"></i>Update Payroll</p>
        </a>
    </li>
                                   <li id="li1" runat="server" class="nav-item">
    <a href="<%= ResolveUrl("~/UI/Dashboard/csmcl_Filetrack.aspx") %>"  class="nav-link">
        <p><i class="bi bi-folder2-open me-2"></i>File Tracking</p>
    </a>
</li>       
    <li id="li2" runat="server" class="nav-item">
    <a href="<%= ResolveUrl("~/UI/Dashboard/csmcl_ratemaster.aspx") %>"  class="nav-link">
        <p><i class="bi bi-folder2-open me-2"></i>Rate Master</p>
    </a>
</li>  
                            <li id="li4" runat="server" class="nav-item">
    <a href="<%= ResolveUrl("~/UI/Agency/UploadDocument.aspx") %>"  class="nav-link">
        <p><i class="bi bi-folder2-open me-2"></i>Upload Document</p>
    </a>
</li>  
                                                    <li id="li5" runat="server" class="nav-item">
    <a href="<%= ResolveUrl("~/UI/Dist/ApproveDocument.aspx") %>"  class="nav-link">
        <p><i class="bi bi-folder2-open me-2"></i>Approve Document</p>
    </a>
</li>  
                                                                            <li id="li6" runat="server" class="nav-item">
    <a href="<%= ResolveUrl("~/UI/Chatbox/csmcl_ChatBox.aspx") %>"  class="nav-link">
        <p><i class="bi bi-folder2-open me-2"></i>Chat Box</p>
    </a>
</li>  
                                                                                                    <li id="li7" runat="server" class="nav-item">
    <a href="<%= ResolveUrl("~/UI/Admin/master.aspx") %>"  class="nav-link">
        <p><i class="bi bi-folder2-open me-2"></i>Add/Deduct Master</p>
    </a>
</li>  
                        
                        
                        
                        <li id="li3" runat="server" class="nav-item">
    <a class="nav-link d-flex justify-content-between align-items-center"
       href="javascript:void(0);"
       data-bs-toggle="collapse"
       data-bs-target="#sidebarSubmenuReport"
       aria-expanded="false"
       aria-controls="sidebarSubmenuReport">

        <span><i class="bi bi-file-earmark-bar-graph me-2"></i> Report</span>
        <i class="bi bi-chevron-down small"></i>
    </a>

    <ul id="sidebarSubmenuReport" class="collapse list-unstyled ps-4 mt-2">
        <li>
            <a class="nav-link py-1" href="<%= ResolveUrl("~/UI/Dist/csmcl_EntryReport.aspx") %>">
                <i class="bi bi-journal-text me-2"></i> District Wise
            </a>
        </li>
        <li>
            <a class="nav-link py-1" href="<%= ResolveUrl("~/UI/Dist/csmcl_SummaryReport.aspx") %>">
                <i class="bi bi-card-checklist me-2"></i> Agency Wise
            </a>
        </li>
         <li>
     <a class="nav-link py-1" href="<%= ResolveUrl("~/UI/Dist/csmcl_SummaryReport.aspx") %>">
         <i class="bi bi-card-checklist me-2"></i> Zone Wise
     </a>
 </li>
       
    </ul>
</li>



                       
                    </ul>
                </nav>

                <!-- MAIN CONTENT -->
                <main id="mainContent" class="col-md-9 col-lg-10 px-md-4 py-4">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
                </main>
            </div>
        </div>
        <!-- FOOTER -->
        <footer class="text-center py-3 border-top">
            <p class="mb-0">&copy; <%: DateTime.Now.Year %> - Placement Agency Management System</p>
        </footer>
    </form>

    <!-- Bootstrap JS bundle (from your bundle config) -->
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>

    <!-- Sidebar hide/show (no fixed layout; we just toggle columns) -->
    <script>
        (function () {
            const btn = document.getElementById('toggleSidebarBtn');
            const sidebar = document.getElementById('sidebarMenu');
            const main = document.getElementById('mainContent');

            btn.addEventListener('click', function () {
                // hide/show sidebar
                sidebar.classList.toggle('d-none');

                // expand / shrink main column
                main.classList.toggle('col-lg-10');
                main.classList.toggle('col-lg-12');
                main.classList.toggle('col-md-9');
                main.classList.toggle('col-md-12');
            });
        })();
    </script>
</body>
</html>
