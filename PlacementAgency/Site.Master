<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="PlacementAgency.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Placement Agency Management</title>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>
    <webopt:BundleReference runat="server" Path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        html, body {
            height: 100%;
        }

        body {
            margin: 0;
            min-height: 100vh;
        }

        /* Make the whole page (inside the form) a vertical flex layout */
        form {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* main container under navbar should take remaining height between navbar and footer */
        .app-main-wrap {
            flex: 1 0 auto;
        }

        .app-header {
            position: sticky;
            top: 0;
            z-index: 1030;
            background: linear-gradient(90deg, #dbeeff 0%, #d4e8ff 52%, #c8e1ff 100%);
            border-bottom: 1px solid #bfd7f2;
            backdrop-filter: blur(6px);
        }
        /* THEME */
        .navbar {
            background: transparent;
        }

        .app-brand {
            display: inline-flex;
            align-items: center;
            gap: .65rem;
            color: #0f2d4a !important;
            font-weight: 800;
            letter-spacing: .02em;
        }

        .brand-badge {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(145deg, #1f8ef1, #0a65c9);
            color: #fff;
            box-shadow: 0 6px 16px rgba(10, 101, 201, .25);
        }

        .toolbar-meta {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: .45rem;
        }

        .toolbar-pill {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            border-radius: 999px;
            border: 1px solid #b8d5f1;
            background: #f4f9ff;
            color: #183552;
            padding: .3rem .6rem;
            font-size: .78rem;
            font-weight: 700;
            line-height: 1;
        }

        .toolbar-pill strong {
            color: #47627d;
            font-weight: 700;
        }

        .toolbar-icon-btn {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            border: 1px solid #b8d5f1;
            background: #f4f9ff;
            color: #164065;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: background .2s ease, transform .2s ease;
        }

        .toolbar-icon-btn:hover {
            background: #dcebfb;
            transform: translateY(-1px);
            color: #0f2d4a;
        }

        .logout-btn {
            border-radius: 10px;
            border-width: 1px;
            font-weight: 700;
            padding: .38rem .6rem;
        }

        .sidebar {
            background-color: #c6e2ff;
            min-height: 100%;
        }

            .sidebar .nav-link {
                display: flex;
                align-items: center;
                gap: .5rem;
                padding: .55rem .85rem;
                border-radius: .45rem;
                color: #003366;
                font-weight: 500;
                font-size: 0.95rem;
                text-decoration: none;
                transition: background-color .15s ease, color .15s ease, transform .08s ease;
            }

                .sidebar .nav-link i {
                    font-size: 1.1rem;
                }

                .sidebar .nav-link p {
                    margin: 0;
                }

                .sidebar .nav-link:hover {
                    background: #b2d8ff;
                    color: #000;
                    transform: translateX(2px);
                }

                .sidebar .nav-link.active {
                    background: #96c5ff;
                    color: #000;
                }

        /* LAYOUT — no fixed positioning anywhere */
        main {
            background: #fff;
        }

        /* Footer sits after content and is pushed down when content is short */
        footer {
            background: #f8f9fa;
            margin-top: auto;
        }

        /* Small devices: refine navbar and stack content nicely */
        @media (max-width: 767.98px) {
            .navbar .navbar-brand {
                font-weight: 600;
                font-size: 1rem;
            }

            .navbar-nav.ms-auto {
                margin-top: .5rem;
            }

            .navbar-nav .nav-item {
                margin-bottom: .15rem;
            }

            .toolbar-meta {
                width: 100%;
                margin-top: .35rem;
            }

            .toolbar-pill {
                font-size: .72rem;
            }

            .sidebar {
                padding-top: .5rem;
            }

                .sidebar .nav-link {
                    padding: .45rem .75rem;
                    font-size: 0.9rem;
                }
        }
        /* server-side active on li -> style link inside it */
        #sidebarMenu .nav-item.active .nav-link {
            background: #b7d8ff; /* selected blue */
            border-radius: 12px;
            color: #000 !important;
            font-weight: 700;
        }

        /* ensure submenu item also shows as active visually (if needed) */
        #sidebarMenu .nav-item #sidebarSubmenuReport .nav-link.active,
        #sidebarMenu .nav-item #sidebarSubmenuReport .nav-item .nav-link.active {
            background: #b7d8ff;
            color: #000 !important;
            font-weight: 700;
        }

        #toggleSidebarBtn {
            border: none !important;
            outline: none !important;
            box-shadow: none !important;
            background: transparent !important;
            padding: 6px;
            border-radius: 8px;
        }

            /* Optional: hover effect */
            #toggleSidebarBtn:hover {
                background: rgba(0,0,0,0.07);
            }
        /* preserve theme color exactly */
        #sidebarMenu {
            background: linear-gradient(180deg, #c6e2ff 0%, #c6e2ff 100%);
            padding: 1rem .6rem;
            border-right: 1px solid rgba(3,28,54,0.06);
            display: flex;
            flex-direction: column;
            gap: .25rem;
        }

        .sidebar-head {
            border-radius: 12px;
            background: linear-gradient(160deg, #f7fbff, #edf5ff);
            border: 1px solid #cfe0f2;
            padding: .65rem .75rem;
            margin-bottom: .45rem;
        }

        .sidebar-head-title {
            margin: 0;
            color: #0c2f4e;
            font-size: .92rem;
            font-weight: 800;
        }

        .sidebar-head-sub {
            margin: .1rem 0 0;
            color: #55708c;
            font-size: .74rem;
            font-weight: 600;
        }

            /* panel "card" look */
            #sidebarMenu .panel {
                background: rgba(255,255,255,0.78);
                border-radius: 12px;
                padding: .6rem;
                box-shadow: 0 6px 20px rgba(3,28,54,0.04);
                overflow: hidden;
            }

        #sidebarMenu .nav {
            display: flex;
            flex-direction: column;
            gap: .35rem;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        #sidebarMenu .nav-item {
            margin: 0;
        }

        #sidebarMenu .nav-link {
            display: flex;
            align-items: center;
            gap: .9rem;
            padding: .55rem .65rem;
            border-radius: 10px;
            text-decoration: none;
            color: #052e45; /* strong text */
            font-weight: 600;
            transition: transform .12s ease, background .12s ease, box-shadow .12s ease;
            position: relative;
        }

        /* left icon capsule */
        .icon-capsule {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(180deg, rgba(255,255,255,0.99), rgba(255,255,255,0.90));
            box-shadow: 0 6px 14px rgba(3,28,54,0.06);
            color: #0a4a67;
            flex: 0 0 42px;
            font-size: 1.1rem;
        }

        /* label */
        #sidebarMenu .nav-link p {
            margin: 0;
            font-size: .96rem;
        }

        /* subtle hover */
        #sidebarMenu .nav-link:hover {
            transform: translateX(6px);
            background: rgba(255,255,255,0.18);
            color: #001824;
            box-shadow: 0 10px 22px rgba(2,20,40,0.06);
        }

        /* active: bright vertical bar + glow */
        #sidebarMenu .nav-link.active {
            background: rgba(255,255,255,0.16);
            box-shadow: 0 14px 30px rgba(2,20,40,0.08);
            color: #001524;
        }

            #sidebarMenu .nav-link.active::before {
                content: "";
                position: absolute;
                left: 0;
                top: 8%;
                bottom: 8%;
                width: 6px;
                background: linear-gradient(180deg,#2b78f6,#155fd0);
                border-radius: 5px;
                box-shadow: 0 6px 16px rgba(21,95,208,0.18);
            }

        /* small count badge (optional) */
        .count-badge {
            margin-left: auto;
            background: linear-gradient(180deg,#1e66d0,#155fd0);
            color: #fff;
            padding: 2px 8px;
            border-radius: 999px;
            font-size: .78rem;
            font-weight: 700;
            box-shadow: 0 3px 10px rgba(21,95,208,0.14);
        }

        /* submenu */
        #sidebarSubmenuReport {
            margin-top: .25rem;
        }

            #sidebarSubmenuReport .nav-link {
                padding-left: 1.25rem;
                font-weight: 600;
                font-size: .92rem;
                border-radius: 8px;
            }

        /* responsive tweaks */
        @media (max-width:767.98px) {
            .icon-capsule {
                width: 42px;
                height: 42px;
                border-radius: 10px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background: linear-gradient(180deg, rgba(255,255,255,0.99), rgba(255,255,255,0.90));
                box-shadow: 0 6px 14px rgba(3,28,54,0.06);
                color: #0a4a67;
                flex: 0 0 42px;
                font-size: 1.1rem;
                /* 👇 Add these 2 lines */
                border: none !important;
                outline: none !important;
            }

            #sidebarMenu .nav-link {
                padding: .45rem .6rem;
                font-size: .92rem;
            }
        }

        #sidebarMenu .nav-link.active {
            background: #b7d8ff; /* your selected blue */
            border-radius: 12px;
            color: #000;
            font-weight: 700;
        }

        /* Global page UI polish (all pages under MainContent) */
        #mainContent {
            background: linear-gradient(180deg, #f8fbff 0%, #f3f8ff 55%, #ffffff 100%);
            border-left: 1px solid #e4edf7;
        }

        #mainContent .card {
            border: 1px solid #dce9f6;
            border-radius: 14px;
            box-shadow: 0 10px 22px rgba(16, 58, 97, .06);
        }

        #mainContent .card-header {
            border-bottom: 1px solid #dce9f6;
            background: linear-gradient(90deg, #ecf5ff 0%, #f5faff 100%);
            border-radius: 14px 14px 0 0 !important;
            font-weight: 700;
            color: #16324d;
        }

        #mainContent .form-label,
        #mainContent .col-form-label {
            font-weight: 700;
            color: #35526f;
        }

        #mainContent .form-control,
        #mainContent .form-select {
            border: 1px solid #cfe0f2;
            border-radius: 10px;
            min-height: 40px;
            box-shadow: none;
        }

        #mainContent .form-control:focus,
        #mainContent .form-select:focus {
            border-color: #9fc4ea;
            box-shadow: 0 0 0 .2rem rgba(31, 142, 241, .12);
        }

        #mainContent .input-group-text {
            border: 1px solid #cfe0f2;
            background: #f3f8ff;
            color: #214565;
            font-weight: 600;
        }

        #mainContent .input-group > .input-group-text {
            min-width: 42px;
            justify-content: center;
            padding-left: .55rem;
            padding-right: .55rem;
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
        }

        #mainContent .input-group > .form-control,
        #mainContent .input-group > .form-select {
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
        }

        #mainContent .input-group > .form-control:focus,
        #mainContent .input-group > .form-select:focus {
            z-index: 3;
        }

        #mainContent .btn {
            border-radius: 10px;
            font-weight: 700;
            letter-spacing: .01em;
        }

        #mainContent .btn-primary {
            background: linear-gradient(145deg, #1f8ef1, #1a73d8);
            border-color: #1a73d8;
        }

        #mainContent .btn-success {
            background: linear-gradient(145deg, #1fab89, #1a936f);
            border-color: #1a936f;
        }

        #mainContent .btn-secondary {
            background: #66788a;
            border-color: #66788a;
        }

        #mainContent .table {
            border: 1px solid #dce9f6;
            border-radius: 12px;
            overflow: hidden;
        }

        #mainContent .table > :not(caption) > * > * {
            border-bottom-color: #e1edf8;
        }

        #mainContent .table thead th {
            background: #f2f8ff;
            color: #395775;
            font-size: .79rem;
            text-transform: uppercase;
            letter-spacing: .03em;
            font-weight: 700;
            white-space: nowrap;
        }

        #mainContent .table tbody tr:hover {
            background: #f7fbff;
        }

        #mainContent .badge {
            border-radius: 999px;
            font-weight: 700;
            padding: .35rem .55rem;
        }

        .app-footer {
            background: #f8f9fa;
            margin-top: auto;
        }
    </style>
</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server" />

        <!-- TOP NAVBAR -->
        <nav class="navbar navbar-expand-lg navbar-light shadow-sm app-header">
            <div class="container-fluid">
                <!-- Sidebar Toggle -->
                <button type="button" id="toggleSidebarBtn" class="me-2">
                    <i class="bi bi-list" style="font-size: 1.5rem;"></i>
                </button>

                <a class="navbar-brand app-brand" href="#">
                    <span class="brand-badge"><i class="bi bi-briefcase-fill"></i></span>
                    <span>Placement Agency</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                    aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav ms-auto align-items-center toolbar-meta">
                        <li class="nav-item">
                            <span class="toolbar-pill">
                                <i class="bi bi-person-circle"></i>
                                <strong>User:</strong>
                                <asp:Label ID="lblusername" runat="server"></asp:Label>
                            </span>
                        </li>
                        <li class="nav-item">
                            <span class="toolbar-pill">
                                <i class="bi bi-shield-check"></i>
                                <strong>Role:</strong>
                                <asp:Label ID="lbluserrole" runat="server"></asp:Label>
                            </span>
                        </li>
                        <li class="nav-item">
                            <span class="toolbar-pill">
                                <i class="bi bi-geo-alt"></i>
                                <strong>District:</strong>
                                <asp:Label ID="lbldistrict" runat="server"></asp:Label>
                            </span>
                        </li>
                        <li class="nav-item position-relative">
                            <a class="position-relative toolbar-icon-btn" href="#"
                                role="button" data-bs-toggle="offcanvas"
                                data-bs-target="#notificationOffcanvas"
                                aria-controls="notificationOffcanvas">

                                <i class="bi bi-bell-fill"></i>

                                <!-- FIXED BADGE POSITION -->
                                <span id="notifyBadge"
                                    class="badge rounded-pill bg-primary position-absolute"
                                    style="top: -4px; right: -6px; font-size: 0.65rem; padding: 3px 6px;">2
                                </span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn btn-sm btn-outline-danger logout-btn" CausesValidation="false" OnClick="btnLogout_Click1" OnClientClick="return confirm('Are you sure you want to logout?');">
                                <i class="bi bi-box-arrow-right me-1"></i>Logout
                            </asp:LinkButton>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- GRID LAYOUT (sidebar is NOT fixed; it scrolls with page) -->
        <div class="container-fluid app-main-wrap">
            <div class="row">
                <!-- SIDEBAR -->
                <!-- ===== Refined Attractive Sidebar (replace existing <nav id="sidebarMenu">) ===== -->
                <nav id="sidebarMenu" class="col-md-3 col-lg-2 sidebar py-4">
                    <div class="sidebar-head">
                        <p class="sidebar-head-title">Navigation</p>
                        <p class="sidebar-head-sub">Quick access modules</p>
                    </div>


                    <div class="panel">
                        <ul class="nav">
                            <li id="lidashboard" runat="server" class="nav-item" visible="false">
                                <a href="<%= ResolveUrl("~/UI/Dashboard/Dashboard.aspx") %>" class="nav-link">
                                    <span class="icon-capsule"><i class="bi bi-speedometer2"></i></span>
                                    <p>Dashboard</p>
                                </a>
                            </li>

                            <li id="lidistapprovepayroll" runat="server" class="nav-item" visible="false">
                                <a href="<%= ResolveUrl("~/UI/Dist/DistApprove.aspx") %>" class="nav-link">
                                    <span class="icon-capsule"><i class="bi bi-person-check"></i></span>
                                    <p>Approve Payroll</p>
                                </a>
                            </li>

                            <li id="liagencyapprove" runat="server" class="nav-item" visible="false">
                                <a href="<%= ResolveUrl("~/UI/Agency/csmcl_AgencyApprovel.aspx") %>" class="nav-link">
                                    <span class="icon-capsule"><i class="bi bi-people-fill"></i></span>
                                    <p>Agency Approval</p>
                                </a>
                            </li>

                            <li id="lipayrolentry" runat="server" class="nav-item" visible="false">
                                <a href="<%= ResolveUrl("~/UI/Dist/csmcl_DistEntry.aspx") %>" class="nav-link">
                                    <span class="icon-capsule"><i class="bi bi-pencil-square"></i></span>
                                    <p>Payroll Entry</p>
                                </a>
                            </li>

                            <li id="liapproveststus" runat="server" class="nav-item" visible="false">
                                <a href="<%= ResolveUrl("~/UI/Dist/csmclDistApproveStatus.aspx") %>" class="nav-link">
                                    <span class="icon-capsule"><i class="bi bi-clipboard-check"></i></span>
                                    <p>Approve Status</p>
                                </a>
                            </li>

                            <li id="lireport" runat="server" class="nav-item" visible="false">
                                <a href="<%= ResolveUrl("~/UI/Dist/csmcl_EntryReport.aspx") %>" class="nav-link">
                                    <span class="icon-capsule"><i class="bi bi-file-earmark-bar-graph"></i></span>
                                    <p>Update Payroll</p>
                                    <!-- example: enable a count by adding <span class="count-badge">3</span> -->
                                </a>
                            </li>

                            <li id="li1" runat="server" class="nav-item" visible="false">
                                <a href="<%= ResolveUrl("~/UI/Dashboard/csmcl_Filetrack.aspx") %>" class="nav-link">
                                    <span class="icon-capsule"><i class="bi bi-folder-symlink"></i></span>
                                    <p>File Tracking</p>
                                </a>
                            </li>

                            <li id="li2" runat="server" class="nav-item" visible="false">
                                <a href="<%= ResolveUrl("~/UI/Dashboard/csmcl_ratemaster.aspx") %>" class="nav-link">
                                    <span class="icon-capsule"><i class="bi bi-currency-rupee"></i></span>
                                    <p>Rate Master</p>
                                </a>
                            </li>

                            <li id="li4" runat="server" class="nav-item" visible="false">
                                <a href="<%= ResolveUrl("~/UI/Agency/UploadDocument.aspx") %>" class="nav-link">
                                    <span class="icon-capsule"><i class="bi bi-cloud-upload"></i></span>
                                    <p>Upload Document</p>
                                </a>
                            </li>

                            <li id="li5" runat="server" class="nav-item" visible="false">
                                <a href="<%= ResolveUrl("~/UI/Dist/ApproveDocument.aspx") %>" class="nav-link">
                                    <span class="icon-capsule"><i class="bi bi-file-earmark-check"></i></span>
                                    <p>Approve Document</p>
                                </a>
                            </li>

                            <li id="li6" runat="server" class="nav-item" visible="false">
                                <a href="<%= ResolveUrl("~/UI/Chatbox/csmcl_ChatBox.aspx") %>" class="nav-link">
                                    <span class="icon-capsule"><i class="bi bi-chat-dots"></i></span>
                                    <p>Chat Box</p>
                                </a>
                            </li>

                            <li id="li7" runat="server" class="nav-item" visible="false">
                                <a href="<%= ResolveUrl("~/UI/Admin/master.aspx") %>" class="nav-link">
                                    <span class="icon-capsule"><i class="bi bi-calculator"></i></span>
                                    <p>Add/Deduct Master</p>
                                </a>
                            </li>

                            <!-- Reports group -->
                            <li id="li3" runat="server" class="nav-item" visible="false">
                                <a class="nav-link d-flex justify-content-between align-items-center collapsed" href="javascript:void(0);"
                                    data-bs-toggle="collapse" data-bs-target="#sidebarSubmenuReport" aria-expanded="false"
                                    aria-controls="sidebarSubmenuReport">
                                    <span class="d-flex align-items-center gap-2">
                                        <span class="icon-capsule"><i class="bi bi-bar-chart-line"></i></span>
                                        <p class="mb-0">Report</p>
                                    </span>
                                    <i class="bi bi-chevron-down" style="font-size: .95rem; color: rgba(3,28,54,0.6)"></i>
                                </a>

                                <ul id="sidebarSubmenuReport" runat="server" class="collapse list-unstyled ps-3 mt-2">

                                    <li>
                                        <a class="nav-link py-1" href="<%= ResolveUrl("~/UI/State/csmcl_distwisereport.aspx") %>">
                                            <i class="bi bi-journal-text me-2"></i>District Wise
                                        </a>
                                    </li>
                                    <li>
                                        <a class="nav-link py-1" href="<%= ResolveUrl("~/UI/Dist/csmcl_SummaryReport.aspx") %>">
                                            <i class="bi bi-card-checklist me-2"></i>Agency Wise
                                        </a>
                                    </li>
                                    <li>
                                        <a class="nav-link py-1" href="<%= ResolveUrl("~/UI/Dist/csmcl_SummaryReport.aspx") %>">
                                            <i class="bi bi-signpost-2 me-2"></i>Zone Wise
                                        </a>
                                    </li>
                                </ul>
                            </li>

                        </ul>
                    </div>
                    <!-- NOTIFICATION OFFCANVAS (place before closing </body>) -->
                    <div class="offcanvas offcanvas-end" tabindex="-1" id="notificationOffcanvas" aria-labelledby="notificationOffcanvasLabel" style="width: 320px;">
                        <div class="offcanvas-header">
                            <h5 class="offcanvas-title" id="notificationOffcanvasLabel">Notifications</h5>
                            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                        </div>

                        <div class="offcanvas-body p-0">
                            <div class="list-group list-group-flush" id="notificationList" style="max-height: 60vh; overflow: auto;">
                                <!-- Example notification items (you will replace/populate dynamically) -->
                                <a href="#" class="list-group-item list-group-item-action">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">Payroll submitted</h6>
                                        <small class="text-muted">2m</small>
                                    </div>
                                    <p class="mb-1 small">New payroll entry waiting for approval.</p>
                                </a>

                                <a href="#" class="list-group-item list-group-item-action">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">Document approved</h6>
                                        <small class="text-muted">1h</small>
                                    </div>
                                    <p class="mb-1 small">Your document X has been approved by admin.</p>
                                </a>

                                <a href="#" class="list-group-item list-group-item-action">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">New message</h6>
                                        <small class="text-muted">3h</small>
                                    </div>
                                    <p class="mb-1 small">You received a new chat message.</p>
                                </a>
                            </div>

                            <div class="border-top p-2 text-center">
                                <button id="markAllReadBtn" class="btn btn-sm btn-outline-secondary">Mark all read</button>
                                <button id="loadMoreNotifications" class="btn btn-sm btn-link">Load more</button>
                            </div>
                        </div>
                    </div>


                    <!-- auto-mark active based on href (robust) -->
                    <script>
                        (function () {
                            var links = document.querySelectorAll('#sidebarMenu a.nav-link');
                            var path = window.location.pathname.toLowerCase();
                            links.forEach(function (a) {
                                var href = (a.getAttribute('href') || '').toLowerCase();
                                if (!href) return;
                                // if href is a page path or contains the page name
                                if (path.endsWith(href) || path.indexOf(href.replace('~', '').replace('/', '')) !== -1 || path.indexOf(href.split('/').pop()) !== -1) {
                                    a.classList.add('active');
                                    var parentCollapse = a.closest('#sidebarSubmenuReport');
                                    if (parentCollapse) {
                                        var bs = bootstrap.Collapse.getOrCreateInstance(parentCollapse);
                                        bs.show();
                                        var toggler = parentCollapse.previousElementSibling;
                                        if (toggler) toggler.classList.remove('collapsed');
                                    }
                                }
                            });
                        })();
                    </script>
                </nav>
                <!-- ===== End refined sidebar ===== -->


                <!-- MAIN CONTENT -->
                <main id="mainContent" class="col-md-9 col-lg-10 px-md-4 py-4">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
                </main>
            </div>
        </div>
        <!-- FOOTER -->
        <footer class="text-center py-3 border-top app-footer">
            <p class="mb-0">&copy; <%: DateTime.Now.Year %> - Placement Agency Management System</p>
        </footer>
    </form>

    <!-- Bootstrap JS bundle (from your bundle config) -->
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>

    <!-- Sidebar hide/show (no fixed layout; we just toggle columns) -->
    <script>
        (function () {
            const btn = document.getElementById('toggleSidebarBtn');
            const sidebar = document.getElementById('sidebarMenu');
            const main = document.getElementById('mainContent');

            btn.addEventListener('click', function () {
                // hide/show sidebar
                sidebar.classList.toggle('d-none');

                // expand / shrink main column
                main.classList.toggle('col-lg-10');
                main.classList.toggle('col-lg-12');
                main.classList.toggle('col-md-9');
                main.classList.toggle('col-md-12');
            });
        })();
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // normalize a path: remove trailing slashes, lowercase
            function norm(p) {
                return (p || "").replace(/\/+$/, "").toLowerCase();
            }

            var currentPath = norm(window.location.pathname);
            var links = document.querySelectorAll("#sidebarMenu a.nav-link");

            // clear any leftover active classes (avoid duplicates)
            links.forEach(function (lnk) { lnk.classList.remove("active"); });

            links.forEach(function (link) {
                var hrefAttr = link.getAttribute("href");
                if (!hrefAttr) return;
                if (/^javascript:/i.test(hrefAttr)) return;

                // parse href relative to current origin so we reliably get pathname
                var linkPath;
                try {
                    var u = new URL(hrefAttr, window.location.origin);
                    linkPath = norm(u.pathname);
                } catch (e) {
                    // fallback: treat href as string and normalize last segment
                    linkPath = norm(hrefAttr);
                }

                // matching criteria:
                // 1) exact pathname match
                // 2) current path endsWith linkPath (handles app virtual dir)
                // 3) last segment match (Dashboard.aspx vs Dashboard.aspx?qs)
                var sameExact = linkPath && currentPath === linkPath;
                var endsWith = linkPath && currentPath.endsWith(linkPath);
                var lastSegmentMatch = (currentPath.split("/").pop() === linkPath.split("/").pop());

                if (sameExact || endsWith || lastSegmentMatch) {
                    link.classList.add("active");

                    // open containing submenu (if it's inside #sidebarSubmenuReport)
                    var submenu = link.closest("#sidebarSubmenuReport");
                    if (submenu) {
                        // use Bootstrap Collapse API to show it if Bootstrap available
                        try {
                            var bs = bootstrap.Collapse.getOrCreateInstance(submenu);
                            bs.show();
                        } catch (_) {
                            submenu.classList.add("show");
                        }
                        // also un-collapse the toggler so caret rotates correctly
                        var toggler = submenu.previousElementSibling;
                        if (toggler) toggler.classList.remove("collapsed");
                    }
                }

                // Add click handler so UI highlights immediately when user clicks (before navigation)
                link.addEventListener("click", function () {
                    links.forEach(function (l) { l.classList.remove("active"); });
                    link.classList.add("active");
                    // open submenu when a submenu item clicked
                    var submenu = link.closest("#sidebarSubmenuReport");
                    if (submenu) {
                        try {
                            bootstrap.Collapse.getOrCreateInstance(submenu).show();
                        } catch (_) { submenu.classList.add("show"); }
                    }
                });
            });
        });
    </script>
    <script>
        (function () {
            // helper to set badge count (0 hides it)
            function setBadgeCount(count) {
                var badge = document.getElementById('notifyBadge');
                if (!badge) return;
                if (!count || count <= 0) {
                    badge.style.display = 'none';
                } else {
                    badge.style.display = 'inline-block';
                    badge.textContent = count > 99 ? '99+' : count;
                }
            }

            // Example: replace notification list items dynamically
            function populateNotifications(items) {
                var list = document.getElementById('notificationList');
                if (!list) return;
                list.innerHTML = ''; // clear current
                if (!items || items.length === 0) {
                    list.innerHTML = '<div class="p-3 text-center text-muted small">No new notifications</div>';
                    setBadgeCount(0);
                    return;
                }
                // build nodes
                items.forEach(function (it) {
                    var a = document.createElement('a');
                    a.href = it.href || '#';
                    a.className = 'list-group-item list-group-item-action';
                    a.innerHTML = '<div class="d-flex w-100 justify-content-between">' +
                        '<h6 class="mb-1">' + (it.title || 'Notification') + '</h6>' +
                        '<small class="text-muted">' + (it.time || '') + '</small>' +
                        '</div>' +
                        '<p class="mb-1 small">' + (it.body || '') + '</p>';
                    list.appendChild(a);
                });

                // update badge
                setBadgeCount(items.filter(i => !i.read).length || items.length);
            }

            // Wire mark all read
            document.getElementById('markAllReadBtn').addEventListener('click', function () {
                // In production: call API to mark notifications read
                // For UI: clear badges and mark items visually
                var items = document.querySelectorAll('#notificationList .list-group-item');
                items.forEach(function (el) { el.classList.remove('fw-bold'); });
                setBadgeCount(0);
            });

            // Example: simulate fetching notifications from server on opening offcanvas
            var offcanvasEl = document.getElementById('notificationOffcanvas');
            offcanvasEl.addEventListener('show.bs.offcanvas', function () {
                // Replace this with fetch('/api/notifications')...
                var demoItems = [
                    { title: 'Payroll submitted', body: 'New payroll entry waiting for approval.', time: '2m', read: false },
                    { title: 'Document approved', body: 'Document X approved by admin.', time: '1h', read: false },
                    { title: 'Message from Ramesh', body: 'Please check the attached file.', time: '3h', read: true }
                ];
                populateNotifications(demoItems);
            });

            // initial badge state (if server-rendered you can output a count server-side)
            // If you want server-side count, render the number into notifyBadge on server.
            setBadgeCount(parseInt(document.getElementById('notifyBadge')?.textContent || '0', 10));
        })();
    </script>
</body>
</html>
