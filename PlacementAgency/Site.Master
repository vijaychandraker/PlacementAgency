<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="PlacementAgency.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Placement Agency Management</title>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>
    <webopt:BundleReference runat="server" Path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />
        <style>
        html, body {
            height: 100%;
        }

        body {
            margin: 0;
            min-height: 100vh;
        }

        /* Make the whole page (inside the form) a vertical flex layout */
        form[runat="server"] {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* main container under navbar should take remaining height between navbar and footer */
        form[runat="server"] > .container-fluid {
            flex: 1 0 auto;
        }
        /* THEME */
        .navbar {
            background-color: #b2cbe5;
        }

        .sidebar {
            background-color: #c6e2ff;
            min-height: 100%;
        }

            .sidebar .nav-link {
                display: flex;
                align-items: center;
                gap: .5rem;
                padding: .55rem .85rem;
                border-radius: .45rem;
                color: #003366;
                font-weight: 500;
                font-size: 0.95rem;
                text-decoration: none;
                transition: background-color .15s ease, color .15s ease, transform .08s ease;
            }

                .sidebar .nav-link i {
                    font-size: 1.1rem;
                }

                .sidebar .nav-link p {
                    margin: 0;
                }

                .sidebar .nav-link:hover {
                    background: #b2d8ff;
                    color: #000;
                    transform: translateX(2px);
                }

                .sidebar .nav-link.active {
                    background: #96c5ff;
                    color: #000;
                }

        /* LAYOUT — no fixed positioning anywhere */
        main {
            background: #fff;
        }

        /* Footer sits after content and is pushed down when content is short */
        footer {
            background: #f8f9fa;
            margin-top: auto;
        }

        /* Small devices: refine navbar and stack content nicely */
        @media (max-width: 767.98px) {
            .navbar .navbar-brand {
                font-weight: 600;
                font-size: 1rem;
            }

            .navbar-nav.ms-auto {
                margin-top: .5rem;
            }

            .navbar-nav .nav-item {
                margin-bottom: .15rem;
            }

            .sidebar {
                padding-top: .5rem;
            }

            .sidebar .nav-link {
                padding: .45rem .75rem;
                font-size: 0.9rem;
            }

        }
/* server-side active on li -> style link inside it */
#sidebarMenu .nav-item.active .nav-link {
    background: #b7d8ff; /* selected blue */
    border-radius: 12px;
    color: #000 !important;
    font-weight: 700;
}

/* ensure submenu item also shows as active visually (if needed) */
#sidebarMenu .nav-item #sidebarSubmenuReport .nav-link.active,
#sidebarMenu .nav-item #sidebarSubmenuReport .nav-item .nav-link.active {
    background: #b7d8ff;
    color: #000 !important;
    font-weight: 700;
}
#toggleSidebarBtn {
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    background: transparent !important;
    padding: 6px;
    border-radius: 8px;
}

/* Optional: hover effect */
#toggleSidebarBtn:hover {
    background: rgba(0,0,0,0.07);
}
    /* preserve theme color exactly */
    #sidebarMenu {
      background: linear-gradient(180deg, #c6e2ff 0%, #c6e2ff 100%);
      padding: 1rem .6rem;
      border-right: 1px solid rgba(3,28,54,0.06);
      display: flex;
      flex-direction: column;
      gap: .25rem;
    }

    /* panel "card" look */
    #sidebarMenu .panel {
      background: rgba(255,255,255,0.78);
      border-radius: 12px;
      padding: .6rem;
      box-shadow: 0 6px 20px rgba(3,28,54,0.04);
      overflow: hidden;
    }

    .nav {
      display: flex;
      flex-direction: column;
      gap: .35rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .nav-item { margin: 0; }

    .nav-link {
      display: flex;
      align-items: center;
      gap: .9rem;
      padding: .55rem .65rem;
      border-radius: 10px;
      text-decoration: none;
      color: #052e45; /* strong text */
      font-weight: 600;
      transition: transform .12s ease, background .12s ease, box-shadow .12s ease;
      position: relative;
    }

    /* left icon capsule */
    .icon-capsule {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(180deg, rgba(255,255,255,0.99), rgba(255,255,255,0.90));
      box-shadow: 0 6px 14px rgba(3,28,54,0.06);
      color: #0a4a67;
      flex: 0 0 42px;
      font-size: 1.1rem;
    }

    /* label */
    .nav-link p { margin: 0; font-size: .96rem; }

    /* subtle hover */
    .nav-link:hover {
      transform: translateX(6px);
      background: rgba(255,255,255,0.18);
      color: #001824;
      box-shadow: 0 10px 22px rgba(2,20,40,0.06);
    }

    /* active: bright vertical bar + glow */
    .nav-link.active {
      background: rgba(255,255,255,0.16);
      box-shadow: 0 14px 30px rgba(2,20,40,0.08);
      color: #001524;
    }
    .nav-link.active::before {
      content: "";
      position: absolute;
      left: 0;
      top: 8%;
      bottom: 8%;
      width: 6px;
      background: linear-gradient(180deg,#2b78f6,#155fd0);
      border-radius: 5px;
      box-shadow: 0 6px 16px rgba(21,95,208,0.18);
    }

    /* small count badge (optional) */
    .count-badge {
      margin-left: auto;
      background: linear-gradient(180deg,#1e66d0,#155fd0);
      color: #fff;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: .78rem;
      font-weight: 700;
      box-shadow: 0 3px 10px rgba(21,95,208,0.14);
    }

    /* submenu */
    #sidebarSubmenuReport { margin-top: .25rem; }
    #sidebarSubmenuReport .nav-link { padding-left: 1.25rem; font-weight:600; font-size:.92rem; border-radius:8px; }

    /* responsive tweaks */
    @media (max-width:767.98px) {
     .icon-capsule {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, rgba(255,255,255,0.99), rgba(255,255,255,0.90));
    box-shadow: 0 6px 14px rgba(3,28,54,0.06);
    color: #0a4a67;
    flex: 0 0 42px;
    font-size: 1.1rem;

    /* 👇 Add these 2 lines */
    border: none !important;
    outline: none !important;
}

      .nav-link { padding:.45rem .6rem; font-size:.92rem; }
    }
    .nav-link.active {
    background: #b7d8ff; /* your selected blue */
    border-radius: 12px;
    color: #000;
    font-weight: 700;
}

  </style>
</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server" />

        <!-- TOP NAVBAR -->
        <nav class="navbar navbar-expand-sm navbar-light shadow-sm">
            <div class="container-fluid">
                <!-- Sidebar Toggle -->
                <button type="button" id="toggleSidebarBtn" class="me-2">
                    <i class="bi bi-list" style="font-size: 1.5rem;"></i>
                </button>

                <a class="navbar-brand text-dark" href="#">Placement Agency</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                    aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="nav-item"> <a style="font-weight:700">UserName:- </a>
                            <asp:Label ID="lblusername" runat="server"></asp:Label> &nbsp</li>
                        <li class="nav-item"><a style="font-weight:700"> UserRole:-</a>
                            <asp:Label ID="lbluserrole" runat="server"></asp:Label> &nbsp</li>
                        <li class="nav-item"><a style="font-weight:700"> District:- </a>
                            <asp:Label ID="lbldistrict" runat="server"></asp:Label></li>
                        <li class="nav-item ms-3">
                            <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn btn-sm btn-outline-danger" CausesValidation="false" OnClick="btnLogout_Click1">
                                <i class="bi bi-box-arrow-right me-1"></i>Logout
                            </asp:LinkButton>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- GRID LAYOUT (sidebar is NOT fixed; it scrolls with page) -->
        <div class="container-fluid">
            <div class="row">
                <!-- SIDEBAR -->
               <!-- ===== Refined Attractive Sidebar (replace existing <nav id="sidebarMenu">) ===== -->
<nav id="sidebarMenu" class="col-md-3 col-lg-2 sidebar py-4">
  

  <div class="panel">
    <ul class="nav">
      <li id="lidashboard" runat="server" class="nav-item" visible="false">
        <a href="<%= ResolveUrl("~/UI/Dashboard/Dashboard.aspx") %>" class="nav-link">
          <span class="icon-capsule"><i class="bi bi-speedometer2"></i></span>
          <p>Dashboard</p>
        </a>
      </li>

      <li id="lidistapprovepayroll" runat="server" class="nav-item"  visible="false">
        <a href="<%= ResolveUrl("~/UI/Dist/DistApprove.aspx") %>" class="nav-link">
          <span class="icon-capsule"><i class="bi bi-person-check"></i></span>
          <p>Approve Payroll</p>
        </a>
      </li>

      <li id="liagencyapprove" runat="server" class="nav-item"  visible="false">
        <a href="<%= ResolveUrl("~/UI/Agency/csmcl_AgencyApprovel.aspx") %>" class="nav-link">
          <span class="icon-capsule"><i class="bi bi-people-fill"></i></span>
          <p>Agency Approval</p>
        </a>
      </li>

      <li id="lipayrolentry" runat="server" class="nav-item"  visible="false">
        <a href="<%= ResolveUrl("~/UI/Dist/csmcl_DistEntry.aspx") %>" class="nav-link">
          <span class="icon-capsule"><i class="bi bi-pencil-square"></i></span>
          <p>Payroll Entry</p>
        </a>
      </li>

      <li id="liapproveststus" runat="server" class="nav-item"  visible="false">
        <a href="<%= ResolveUrl("~/UI/Dist/csmclDistApproveStatus.aspx") %>" class="nav-link">
          <span class="icon-capsule"><i class="bi bi-clipboard-check"></i></span>
          <p>Approve Status</p>
        </a>
      </li>

      <li id="lireport" runat="server" class="nav-item"  visible="false">
        <a href="<%= ResolveUrl("~/UI/Dist/csmcl_EntryReport.aspx") %>" class="nav-link">
          <span class="icon-capsule"><i class="bi bi-file-earmark-bar-graph"></i></span>
          <p>Update Payroll</p>
          <!-- example: enable a count by adding <span class="count-badge">3</span> -->
        </a>
      </li>

      <li id="li1" runat="server" class="nav-item"  visible="false">
        <a href="<%= ResolveUrl("~/UI/Dashboard/csmcl_Filetrack.aspx") %>" class="nav-link">
          <span class="icon-capsule"><i class="bi bi-folder-symlink"></i></span>
