        </a>
      </li>

      <li id="li2" runat="server" class="nav-item"  visible="false">
        <a href="<%= ResolveUrl("~/UI/Dashboard/csmcl_ratemaster.aspx") %>" class="nav-link">
          <span class="icon-capsule"><i class="bi bi-currency-rupee"></i></span>
          <p>Rate Master</p>
        </a>
      </li>

      <li id="li4" runat="server" class="nav-item"  visible="false">
        <a href="<%= ResolveUrl("~/UI/Agency/UploadDocument.aspx") %>" class="nav-link">
          <span class="icon-capsule"><i class="bi bi-cloud-upload"></i></span>
          <p>Upload Document</p>
        </a>
      </li>

      <li id="li5" runat="server" class="nav-item"  visible="false">
        <a href="<%= ResolveUrl("~/UI/Dist/ApproveDocument.aspx") %>" class="nav-link">
          <span class="icon-capsule"><i class="bi bi-file-earmark-check"></i></span>
          <p>Approve Document</p>
        </a>
      </li>

      <li id="li6" runat="server" class="nav-item"  visible="false">
        <a href="<%= ResolveUrl("~/UI/Chatbox/csmcl_ChatBox.aspx") %>" class="nav-link">
          <span class="icon-capsule"><i class="bi bi-chat-dots"></i></span>
          <p>Chat Box</p>
        </a>
      </li>

      <li id="li7" runat="server" class="nav-item"  visible="false">
        <a href="<%= ResolveUrl("~/UI/Admin/master.aspx") %>" class="nav-link">
          <span class="icon-capsule"><i class="bi bi-calculator"></i></span>
          <p>Add/Deduct Master</p>
        </a>
      </li>

      <!-- Reports group -->
      <li id="li3" runat="server" class="nav-item"  visible="false">
        <a class="nav-link d-flex justify-content-between align-items-center collapsed" href="javascript:void(0);"
           data-bs-toggle="collapse" data-bs-target="#sidebarSubmenuReport" aria-expanded="false"
           aria-controls="sidebarSubmenuReport">
          <span class="d-flex align-items-center gap-2">
            <span class="icon-capsule"><i class="bi bi-bar-chart-line"></i></span>
            <p class="mb-0">Report</p>
          </span>
          <i class="bi bi-chevron-down" style="font-size:.95rem;color:rgba(3,28,54,0.6)"></i>
        </a>

       <ul id="sidebarSubmenuReport" runat="server" class="collapse list-unstyled ps-3 mt-2">

          <li>
            <a class="nav-link py-1" href="<%= ResolveUrl("~/UI/Dist/csmcl_EntryReport.aspx") %>">
              <i class="bi bi-journal-text me-2"></i> District Wise
            </a>
          </li>
          <li>
            <a class="nav-link py-1" href="<%= ResolveUrl("~/UI/Dist/csmcl_SummaryReport.aspx") %>">
              <i class="bi bi-card-checklist me-2"></i> Agency Wise
            </a>
          </li>
          <li>
            <a class="nav-link py-1" href="<%= ResolveUrl("~/UI/Dist/csmcl_SummaryReport.aspx") %>">
              <i class="bi bi-signpost-2 me-2"></i> Zone Wise
            </a>
          </li>
        </ul>
      </li>

    </ul>
  </div>

  <!-- auto-mark active based on href (robust) -->
  <script>
      (function () {
          var links = document.querySelectorAll('#sidebarMenu a.nav-link');
          var path = window.location.pathname.toLowerCase();
          links.forEach(function (a) {
              var href = (a.getAttribute('href') || '').toLowerCase();
              if (!href) return;
              // if href is a page path or contains the page name
              if (path.endsWith(href) || path.indexOf(href.replace('~', '').replace('/', '')) !== -1 || path.indexOf(href.split('/').pop()) !== -1) {
                  a.classList.add('active');
                  var parentCollapse = a.closest('#sidebarSubmenuReport');
                  if (parentCollapse) {
                      var bs = bootstrap.Collapse.getOrCreateInstance(parentCollapse);
                      bs.show();
                      var toggler = parentCollapse.previousElementSibling;
                      if (toggler) toggler.classList.remove('collapsed');
                  }
              }
          });
      })();
  </script>
</nav>
<!-- ===== End refined sidebar ===== -->


                <!-- MAIN CONTENT -->
                <main id="mainContent" class="col-md-9 col-lg-10 px-md-4 py-4">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
                </main>
            </div>
        </div>
        <!-- FOOTER -->
        <footer class="text-center py-3 border-top">
            <p class="mb-0">&copy; <%: DateTime.Now.Year %> - Placement Agency Management System</p>
        </footer>
    </form>

    <!-- Bootstrap JS bundle (from your bundle config) -->
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>

    <!-- Sidebar hide/show (no fixed layout; we just toggle columns) -->
    <script>
        (function () {
            const btn = document.getElementById('toggleSidebarBtn');
            const sidebar = document.getElementById('sidebarMenu');
            const main = document.getElementById('mainContent');

            btn.addEventListener('click', function () {
                // hide/show sidebar
                sidebar.classList.toggle('d-none');

                // expand / shrink main column
                main.classList.toggle('col-lg-10');
                main.classList.toggle('col-lg-12');
                main.classList.toggle('col-md-9');
                main.classList.toggle('col-md-12');
            });
        })();
    </script>
   <script>
       document.addEventListener("DOMContentLoaded", function () {
           // normalize a path: remove trailing slashes, lowercase
           function norm(p) {
               return (p || "").replace(/\/+$/, "").toLowerCase();
           }

           var currentPath = norm(window.location.pathname);
           var links = document.querySelectorAll("#sidebarMenu a.nav-link");

           // clear any leftover active classes (avoid duplicates)
           links.forEach(function (lnk) { lnk.classList.remove("active"); });

           links.forEach(function (link) {
               var hrefAttr = link.getAttribute("href");
               if (!hrefAttr) return;
               if (/^javascript:/i.test(hrefAttr)) return;

               // parse href relative to current origin so we reliably get pathname
               var linkPath;
               try {
                   var u = new URL(hrefAttr, window.location.origin);
                   linkPath = norm(u.pathname);
               } catch (e) {
                   // fallback: treat href as string and normalize last segment
                   linkPath = norm(hrefAttr);
               }

               // matching criteria:
               // 1) exact pathname match
               // 2) current path endsWith linkPath (handles app virtual dir)
               // 3) last segment match (Dashboard.aspx vs Dashboard.aspx?qs)
               var sameExact = linkPath && currentPath === linkPath;
               var endsWith = linkPath && currentPath.endsWith(linkPath);
               var lastSegmentMatch = (currentPath.split("/").pop() === linkPath.split("/").pop());

               if (sameExact || endsWith || lastSegmentMatch) {
                   link.classList.add("active");

                   // open containing submenu (if it's inside #sidebarSubmenuReport)
                   var submenu = link.closest("#sidebarSubmenuReport");
                   if (submenu) {
                       // use Bootstrap Collapse API to show it if Bootstrap available
                       try {
                           var bs = bootstrap.Collapse.getOrCreateInstance(submenu);
                           bs.show();
                       } catch (_) {
                           submenu.classList.add("show");
                       }
                       // also un-collapse the toggler so caret rotates correctly
                       var toggler = submenu.previousElementSibling;
                       if (toggler) toggler.classList.remove("collapsed");
                   }
               }

               // Add click handler so UI highlights immediately when user clicks (before navigation)
               link.addEventListener("click", function () {
                   links.forEach(function (l) { l.classList.remove("active"); });
                   link.classList.add("active");
                   // open submenu when a submenu item clicked
                   var submenu = link.closest("#sidebarSubmenuReport");
                   if (submenu) {
                       try {
                           bootstrap.Collapse.getOrCreateInstance(submenu).show();
                       } catch (_) { submenu.classList.add("show"); }
                   }
               });
           });
       });
   </script>


</body>
</html>
